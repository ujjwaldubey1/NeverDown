# Host / SDK process env — copy into the app that calls NeverDown.create.
# Do NOT put Hedera spend or operator private keys here.
# NeverDown.create rejects HEDERA_SPEND_KEY, HEDERA_OPERATOR_KEY,
# ARKIV_PRIVATE_KEY, and RECLAIM_PRIVATE_KEY in the host env.

# Required for NeverDown.create (read-only rails)
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_ALLOWLIST_NAMES=neverdownseller.eth

# Independent Sepolia RPC for proveCapability (must differ from candidate)
POC_REFERENCE_RPC=https://rpc.sepolia.org

# Arkiv discovery (optional for monitor-only demos; required for procure)
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=

# Gateway the dApp talks to (status + install plane). No /rpc suffix here.
GATEWAY_URL=http://127.0.0.1:8787
GATEWAY_INTERNAL_TOKEN=

# Path to a mode-0600 file that ONLY the payment worker reads.
# That file holds HEDERA_SPEND_KEY / HEDERA_OPERATOR_KEY / POLICY_* budget.
# The host process must not load those signing keys.
PAYMENT_WORKER_ENV_FILE=

# Seller identity used by optional procure demos
SELLER_ENS_NAME=neverdownseller.eth
HEDERA_MERCHANT_ACCOUNT_ID=
