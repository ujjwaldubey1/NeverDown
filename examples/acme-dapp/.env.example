# Acme Portfolio Reader — host env only (no spend keys).
# Prefer copying packages/sdk/env.host.example and adding the lines below.

# Mode A (without NeverDown): direct / flaky upstream the dApp owns
DIRECT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Mode B (with NeverDown): ONE stable gateway RPC URL — do not change on failover
RPC_URL=http://127.0.0.1:8787/rpc
GATEWAY_URL=http://127.0.0.1:8787

# Outage lab control plane (pnpm outage-lab)
OUTAGE_LAB_URL=http://127.0.0.1:8790

# UI
ACME_PORT=3200
POLL_INTERVAL_MS=1500

# SDK host rails (NeverDown.create) — never put HEDERA_*_KEY here
ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_ALLOWLIST_NAMES=neverdownseller.eth
POC_REFERENCE_RPC=https://rpc.sepolia.org
ARKIV_ACCESS_KEY=
ARKIV_RPC=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
GATEWAY_INTERNAL_TOKEN=
PAYMENT_WORKER_ENV_FILE=
SELLER_ENS_NAME=neverdownseller.eth
HEDERA_MERCHANT_ACCOUNT_ID=
